---
import "@styles/fog-posters.css";

interface Props {
  targetId?: string;
  variant?: "hero" | "panel";
}

const { targetId, variant = "panel" } = Astro.props;
---

<interactive-fog data-target={targetId} data-variant={variant} aria-hidden="true">
  <div class="fog-poster"></div>
  <div class="fog-layer"></div>
</interactive-fog>

<style>
  interactive-fog {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    pointer-events: none;
    background: #cad4f4;
  }

  :global(.dark) interactive-fog,
  interactive-fog[data-variant="panel"] {
    background: #18243d;
  }

  .fog-poster {
    position: absolute;
    inset: -32px;
    background: var(--fog-poster) center / cover;
    filter: brightness(0.965);
    animation: fog-drift 16s ease-in-out infinite alternate;
  }

  @keyframes fog-drift {
    from { transform: translate3d(-6px, -4px, 0) scale(1.04); }
    to { transform: translate3d(6px, 4px, 0) scale(1.07); }
  }

  interactive-fog[data-ready] .fog-poster {
    animation-play-state: paused;
  }

  .fog-layer {
    position: absolute;
    inset: -32px;
    opacity: 0;
    filter: brightness(0.965);
    transform: translate3d(var(--fog-x, 0px), var(--fog-y, 0px), 0) scale(1.04);
    transition: transform 350ms ease-out, opacity 180ms ease-out;
  }

  interactive-fog[data-ready] .fog-layer {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .fog-layer { transform: none; transition: none; }
    .fog-poster { animation: none; }
  }
</style>

<script>
  type FogEffect = { destroy: () => void; renderer?: object };
  const fogWindow = window as typeof window & {
    VANTA?: { FOG: (options: Record<string, unknown>) => FogEffect };
  };
  let scripts: Promise<void> | undefined;

  function loadScript(src: string) {
    return new Promise<void>((resolve, reject) => {
      const script = document.createElement("script");
      // Download both dependencies together, but execute THREE before VANTA.
      script.async = false;
      script.src = src;
      script.onload = () => resolve();
      script.onerror = () => reject(new Error(`Could not load ${src}`));
      document.head.append(script);
    });
  }

  function loadFog() {
    return scripts ??= Promise.all([
      loadScript("/js/three.r134.min.js"),
      loadScript("/js/vanta.fog.min.js"),
    ]).then(() => undefined);
  }

  class InteractiveFog extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      this.cleanup?.();
      const target = this.dataset.target
        ? document.getElementById(this.dataset.target)
        : this.parentElement;
      const layer = this.querySelector<HTMLElement>(".fog-layer");
      if (!target || !layer) return;

      const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let effect: FogEffect | undefined;
      const initialRect = target.getBoundingClientRect();
      let visible = initialRect.bottom > 0 && initialRect.top < window.innerHeight;
      let disposed = false;
      let version = 0;
      let frame = 0;
      let pointerX = 0;
      let pointerY = 0;

      const destroy = () => {
        version++;
        effect?.destroy();
        effect = undefined;
        delete this.dataset.ready;
      };

      const render = () => {
        frame = 0;
        if (motion.matches || !visible) return;
        const rect = target.getBoundingClientRect();
        const scroll = Math.max(-1, Math.min(1,
          (window.innerHeight / 2 - rect.top - rect.height / 2) / window.innerHeight));
        this.style.setProperty("--fog-x", `${pointerX * 18}px`);
        this.style.setProperty("--fog-y", `${pointerY * 12 + scroll * 24}px`);
      };

      const schedule = () => {
        if (!frame && visible && !motion.matches) frame = requestAnimationFrame(render);
      };

      const start = async () => {
        destroy();
        if (motion.matches || !visible || disposed) return;
        const current = version;
        try {
          await loadFog();
          if (current !== version || disposed || !visible || motion.matches) return;
          const dark = this.dataset.variant === "panel" || document.documentElement.classList.contains("dark");
          effect = fogWindow.VANTA?.FOG({
            el: layer,
            // The component handles pointer and scroll panning.
            mouseControls: false,
            touchControls: false,
            gyroControls: false,
            minHeight: 200,
            minWidth: 200,
            highlightColor: 0x7f86e8,
            midtoneColor: 0x00a3ff,
            lowlightColor: 0x222222,
            baseColor: dark ? 0x000000 : 0xffffff,
            blurFactor: 0.9,
            speed: 1.1,
            zoom: 0.45,
          });
          if (effect?.renderer) {
            this.dataset.ready = "true";
          }
          schedule();
        } catch {
          destroy();
          // The initial fog texture remains visible if WebGL or a script is unavailable.
        }
      };

      const onPointer = (event: PointerEvent) => {
        if (motion.matches || event.pointerType === "touch") return;
        const rect = target.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width;
        const y = (event.clientY - rect.top) / rect.height;
        pointerX = x * 2 - 1;
        pointerY = y * 2 - 1;
        schedule();
      };

      const resetPointer = () => {
        pointerX = pointerY = 0;
        schedule();
      };

      const onMotionChange = () => {
        this.removeAttribute("style");
        resetPointer();
        void start();
      };
      const viewport = new IntersectionObserver(([entry]) => {
        if (visible === entry.isIntersecting) return;
        visible = entry.isIntersecting;
        if (visible) void start();
        else destroy();
      });
      const theme = new MutationObserver(() => { void start(); });
      viewport.observe(target);
      theme.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
      target.addEventListener("pointermove", onPointer);
      target.addEventListener("pointerleave", resetPointer);
      window.addEventListener("scroll", schedule, { passive: true });
      motion.addEventListener("change", onMotionChange);
      // Start the visible hero immediately; the observer only manages later visibility changes.
      if (visible) void start();

      this.cleanup = () => {
        disposed = true;
        destroy();
        cancelAnimationFrame(frame);
        viewport.disconnect();
        theme.disconnect();
        target.removeEventListener("pointermove", onPointer);
        target.removeEventListener("pointerleave", resetPointer);
        window.removeEventListener("scroll", schedule);
        motion.removeEventListener("change", onMotionChange);
      };
    }

    disconnectedCallback() { this.cleanup?.(); }
  }

  if (!customElements.get("interactive-fog")) {
    customElements.define("interactive-fog", InteractiveFog);
  }
</script>
