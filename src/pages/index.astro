]
*/
---

<PageLayout title="Home" description={SITE.DESCRIPTION}>
  <!-- VANTA Fog Animation Background -->
  <section id="vanta-hero" class="relative min-h-screen w-full overflow-hidden">
    <!-- Animated Background Container -->
    <InteractiveFog targetId="vanta-hero" variant="hero" />
    
    <!-- Content Container -->
    <div class="relative z-10 min-h-screen w-full flex items-center py-28">
      <div class="container mx-auto px-8 md:px-12 lg:px-16 flex items-center justify-center h-full">
        <div class="w-full max-w-4xl text-center md:text-left">
          <h1 class="text-4xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-black dark:text-white mb-6 leading-tight">
            Lukas Niessen
          </h1>
          <p class="text-lg md:text-xl lg:text-2xl text-black/90 dark:text-white/90 max-w-3xl leading-relaxed mx-auto md:mx-0">
            {t("home.about")}
          </p>
          <div class="mt-8 flex justify-center md:justify-start">
            <a
              id="scroll-to-next"
              href="#archunit"
              aria-label="Scroll to content section"
              class="group inline-flex items-center gap-2 px-4 py-2 text-black dark:text-white border border-gray-400/70 dark:border-gray-600/50 rounded-lg hover:border-warmAccent-primary dark:hover:border-warmAccent-secondary hover:text-warmAccent-primary dark:hover:text-warmAccent-secondary transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-warmAccent-secondary"
            >
              <span class="text-base font-medium">Explore</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="stroke-current transition-transform duration-300 ease-in-out group-hover:translate-y-0.5"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="relative bg-warmBg-light dark:bg-warmBg-dark">
    <div class="mx-auto max-w-screen-sm p-5 space-y-24 pb-16 mt-12">

      <section class="animate project-card" id="archunit" aria-labelledby="archunit-title">
        <span id="archunitts" class="block" aria-hidden="true"></span>
        <span id="archunitpython" class="block" aria-hidden="true"></span>
        <div class="space-y-4">
          <p class="text-xs font-semibold uppercase tracking-widest text-black/60 dark:text-white/60">Open source</p>
          <div class="flex items-center gap-3">
            <img
              src="/archunitts-logo.png"
              alt=""
              width="40"
              height="40"
              class="size-10 rounded"
              loading="lazy"
            />
            <h2 id="archunit-title" class="font-semibold text-black dark:text-white text-2xl">ArchUnit</h2>
          </div>
          <p class="text-black/80 dark:text-white/80 leading-relaxed">
            I build and maintain ArchUnit, a growing family of open source architecture testing libraries.
            It started with ArchUnitTS and ArchUnitPython and now covers more languages and ecosystems.
            Keep dependency rules, circular dependency checks, and architecture boundaries in your test suite,
            so you can catch violations as the code changes.
          </p>
          <div class="flex flex-wrap gap-3 pt-2">
            <a href="https://www.archunit.net/" target="_blank" rel="noopener noreferrer" class="project-link project-link-primary">
              Explore ArchUnit <span aria-hidden="true">↗</span>
            </a>
            <a href="/projects/archunits" class="project-link project-link-secondary">
              About ArchUnitTS
            </a>
          </div>
        </div>
      </section>

      <section aria-labelledby="skills-title" class="space-y-6">
        <div class="space-y-2">
          <h2 id="skills-title" class="font-semibold text-black dark:text-white text-2xl">AI coding skills</h2>
          <p class="text-black/65 dark:text-white/65">Practical guidance for coding agents working with infrastructure.</p>
        </div>
        <!-- TerraShark Section -->
        <section class="animate project-card" id="terrashark">
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <img
                src="/terrashark-logo.png"
                alt=""
                width="32"
                height="32"
                class="size-8 rounded"
                loading="lazy"
              />
              <h3 class="font-semibold text-black dark:text-white text-xl">
                TerraShark
              </h3>
            </div>
            <p class="text-black/80 dark:text-white/80">
              I created TerraShark, a Terraform/OpenTofu skill that prevents IaC hallucinations by guiding LLMs through a failure-mode workflow. It’s token-efficient, security-first, and based on HashiCorp’s official best practices.
            </p>
            <div class="flex flex-wrap gap-3 mt-4">
              <a
                href="https://terraformskill.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="project-link project-link-primary"
              >
                Learn More
              </a>
              <a
                href="https://github.com/LukasNiessen/terrashark"
                target="_blank"
                rel="noopener noreferrer"
                class="project-link project-link-secondary"
              >
                View on GitHub
              </a>
            </div>
          </div>
        </section>

        <!-- KubeShark Section -->
        <section class="animate project-card" id="kubeshark">
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <img
                src="/kubeshark-logo.png"
                alt=""
                width="32"
                height="32"
                class="size-8 rounded"
                loading="lazy"
              />
              <h3 class="font-semibold text-black dark:text-white text-xl">
                KubeShark
              </h3>
            </div>
            <p class="text-black/80 dark:text-white/80">
              I created KubeShark, a Kubernetes skill for Claude Code and Codex that fixes hallucinations in generated manifests, Helm charts, and RBAC configs. It’s token-efficient and grounded in official Kubernetes docs, the NSA/CISA Hardening Guide, OWASP Kubernetes Top 10, and the CIS Benchmark.
            </p>
            <div class="flex flex-wrap gap-3 mt-4">
              <a
                href="https://lukasniessen.github.io/kubernetes-skill/"
                target="_blank"
                rel="noopener noreferrer"
                class="project-link project-link-primary"
              >
                Learn More
              </a>
              <a
                href="https://github.com/LukasNiessen/kubernetes-skill"
                target="_blank"
                rel="noopener noreferrer"
                class="project-link project-link-secondary"
              >
                View on GitHub
              </a>
            </div>
          </div>
        </section>

      </section>

      <!-- Blog Preview Section -->
      <section id="recent-posts" class="animate">
        <div class="space-y-4">
          <div class="flex items-center justify-between gap-4">
            <h2 class="font-semibold text-black dark:text-white text-2xl">
              {t("home.recent.posts")}
            </h2>
            <a href="/blog" class="w-fit col-span-3 group flex gap-1 items-center underline decoration-[.5px] decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white text-black dark:text-white underline-offset-2 blend">
              <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">
                {t("home.all.posts")}
              </span>
            </a>
          </div>          <ul class="space-y-4">
            {posts.map((post) => (
              <li>
                <ArrowCard entry={post} />
              </li>
            ))}
          </ul>
          <div class="flex justify-center mt-8">
            <a 
              href="/blog" 
              class="project-link project-link-primary"
            >
              See all articles
            </a>
          </div>
        </div>
      </section>

      <!-- Project Preview Section -->
      <!--
      <section class="animate">
        <div class="space-y-4">
          <div class="flex justify-between">
            <p class="font-semibold text-black dark:text-white">
              {t("home.recent.projects")}
            </p>
            <a href="/projects" class="w-fit col-span-3 group flex gap-1 items-center underline decoration-[.5px] decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white text-black dark:text-white underline-offset-2 blend">
              <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">
                {t("home.all.projects")}
              </span>
            </a>
          </div>
          <ul class="space-y-4">
            {projects.map((project) => (
              <li>
                <ArrowCard entry={project} />
              </li>
            ))}
          </ul>
        </div>
      </section>
      -->      

      <!-- Contact Section -->
      <section class="animate">
        <div class="flex flex-col sm:flex-row gap-6 items-center">
          <div class="w-full sm:w-2/3 order-2 sm:order-1">
            <h2 class="font-semibold text-black dark:text-white text-2xl">
              {t("home.connect")}
            </h2>
            <p class="mt-4">
              {t("home.interests")}
            </p>
            <div class="grid grid-cols-4 gap-y-2 mt-5 auto-cols-min">
              {SOCIALS.map(social => (
                <div class="col-span-1 flex items-center gap-1">
                  <span class="whitespace-nowrap truncate">
                    {social.NAME}
                  </span>
                </div>
                <div class="col-span-3 truncate">
                  <a href={social.HREF} target="_blank" class="w-fit col-span-3 group flex gap-1 items-center underline decoration-[.5px] decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white text-black dark:text-white underline-offset-2 blend">
                    <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">
                      {social.TEXT}
                    </span>
                  </a>
                </div>
              ))}
            </div>
          </div>
          <div class="w-full sm:w-1/3 flex justify-center order-1 sm:order-2 hidden sm:flex">
            <img 
              src="/portrait.avif" 
              alt="Lukas Niessen - Software Architect and Full Stack Developer" 
              width="160"
              height="160"
              class="size-40 rounded-xl object-cover shadow-md"
            />
          </div>
        </div>
      </section>
    </div>
  </div>
</PageLayout>

<style>
  .project-card {
    @apply rounded-2xl border border-black/10 dark:border-white/15 p-6 sm:p-7;
    transition: border-color 200ms ease, box-shadow 200ms ease, opacity 450ms ease, transform 450ms ease;
  }

  .project-card:hover,
  .project-card:focus-within {
    @apply border-warmAccent-secondary/50 shadow-sm;
  }

  .project-link {
    @apply inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm font-medium;
    @apply focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-warmAccent-secondary;
    transition: background-color 200ms ease, border-color 200ms ease;
  }

  .project-link-primary {
    @apply bg-warmAccent-primary text-slate-950 hover:bg-sky-300;
  }

  .project-link-secondary {
    @apply border border-black/20 dark:border-white/25 text-sky-700 dark:text-sky-300;
    @apply hover:bg-sky-50 dark:hover:bg-sky-950/40 hover:border-sky-500;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-link { transition: none; }
  }
</style>
